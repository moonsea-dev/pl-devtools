{
    "name": "moonsea-dev/pl-devtools",
    "description": "Opt-in Laravel developer tools: request profiler, SQL timeline, server and security diagnostics.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "devtools",
        "debug",
        "sql",
        "profiler",
        "diagnostics"
    ],
    "authors": [
        {
            "name": "Moonsea",
            "homepage": "https://moonsea.dev"
        }
    ],
    "homepage": "https://moonsea.dev",
    "support": {
        "issues": "https://github.com/moonsea-dev/pl-devtools/issues",
        "source": "https://github.com/moonsea-dev/pl-devtools"
    },
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Moonsea\\DevTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moonsea\\DevTools\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moonsea\\DevTools\\DevToolsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
